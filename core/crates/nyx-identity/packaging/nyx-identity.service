[Unit]
Description=NyxOS identity manager (MAC/hostname/timezone/IPv6)
After=network-pre.target dbus.service NetworkManager.service
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/nyx-identity
Restart=on-failure
RestartSec=2
RuntimeDirectory=nyx
# 0755 + Preserve=yes: /run/nyx is shared by every Nyx daemon and created
# root:root by systemd; 0750 locks wheel users out of the 0660 root:wheel
# sockets, and without Preserve a single daemon restart removes the whole
# directory (and every sibling's socket) — see nyx-health.service.
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
