[Unit]
Description=NyxOS system integrity verification daemon
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/nyx-integrity
Restart=on-failure
RestartSec=5
RuntimeDirectory=nyx
# 0755 + Preserve=yes: /run/nyx is shared by every Nyx daemon and created
# root:root by systemd; 0750 locks wheel users out of the 0660 root:wheel
# sockets, and without Preserve a single daemon restart removes the whole
# directory (and every sibling's socket) — see nyx-health.service.
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
