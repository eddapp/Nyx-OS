[Unit]
Description=NyxOS mieru anti-censorship proxy client for profile %i
After=network-online.target dbus.service
Wants=network-online.target
PartOf=nyx-vpn.service

[Service]
Type=simple
ExecStart=/usr/bin/env MIERU_CONFIG_JSON_FILE=/etc/nyx/mieru/%i.json /usr/bin/mieru run
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
