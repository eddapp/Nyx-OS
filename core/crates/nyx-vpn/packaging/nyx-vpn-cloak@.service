[Unit]
Description=NyxOS Cloak (ck-client) obfuscation layer for profile %i
After=network-online.target dbus.service
Wants=network-online.target
PartOf=nyx-vpn.service

[Service]
Type=simple
ExecStart=/usr/bin/ck-client -c /run/nyx/nyx-vpn-cloak-%i-ckclient.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
