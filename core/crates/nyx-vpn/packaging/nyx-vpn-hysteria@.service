[Unit]
Description=NyxOS Hysteria2 client for profile %i
After=network-online.target dbus.service
Wants=network-online.target
PartOf=nyx-vpn.service

[Service]
Type=simple
ExecStart=/usr/bin/hysteria client -c /etc/nyx/hysteria/%i.yaml
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
