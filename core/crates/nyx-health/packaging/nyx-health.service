[Unit]
Description=NyxOS control daemon (kill switch, firewall, Tor lifecycle)
After=network-pre.target dbus.service
Wants=network-pre.target
Before=network.target

[Service]
Type=simple
ExecStart=/usr/bin/nyx-health
Restart=on-failure
RestartSec=2
RuntimeDirectory=nyx
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
