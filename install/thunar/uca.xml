<?xml version="1.0" encoding="UTF-8"?>
<!--
  NyxOS default Thunar custom actions. Shipped by nyx-thunar-integration as
  /etc/skel/.config/Thunar/uca.xml, so every new user starts with it as
  their own ~/.config/Thunar/uca.xml. Thunar loads exactly one uca.xml (the
  user's, else /etc/xdg/Thunar's) and never merges them, which is why the
  stock "Open Terminal Here" action is carried here too, and why this file
  can't live at /etc/xdg/Thunar/uca.xml (the thunar package owns that path).

  Every destructive action here delegates to a reviewed Nyx binary
  (nyx-wipe, nyx-isolation) or a well-known tool (mat2, sha256sum, pkexec)
  rather than reimplementing path/privilege logic in shell — see
  install/thunar/nyx-thunar-*.sh, which are UI glue only.
-->
<actions>
  <action>
    <icon>utilities-terminal</icon>
    <name>Open Terminal Here</name>
    <unique-id>org.nyxos.thunar.open-terminal-1</unique-id>
    <command>exo-open --working-directory %f --launch TerminalEmulator</command>
    <description>Open a terminal in this folder</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>

  <action>
    <icon>edit-delete</icon>
    <name>NyxOS Secure Wipe</name>
    <unique-id>org.nyxos.thunar.wipe-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-wipe.sh %F</command>
    <description>Permanently destroy the selected file(s) — irreversible</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>utilities-terminal</icon>
    <name>NyxOS Sandbox Shell Here</name>
    <unique-id>org.nyxos.thunar.sandbox-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-sandbox.sh %f</command>
    <description>Open a Firejail-sandboxed terminal rooted at this folder</description>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>

  <action>
    <icon>document-properties</icon>
    <name>NyxOS Strip Metadata</name>
    <unique-id>org.nyxos.thunar.metadata-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-metadata.sh %F</command>
    <description>Remove EXIF/GPS/author/timestamp metadata in place (mat2) — irreversible</description>
    <patterns>*</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>document-properties</icon>
    <name>NyxOS SHA-256 Checksum</name>
    <unique-id>org.nyxos.thunar.checksum-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-checksum.sh %F</command>
    <description>Show the SHA-256 checksum of the selected file(s)</description>
    <patterns>*</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>dialog-password</icon>
    <name>NyxOS Open As Root</name>
    <unique-id>org.nyxos.thunar.root-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-root.sh %f</command>
    <description>Open this location as root via polkit (audited, not a blanket sudo rule)</description>
    <patterns>*</patterns>
    <directories/>
    <other-files/>
  </action>

  <action>
    <icon>edit-copy</icon>
    <name>NyxOS Copy Path</name>
    <unique-id>org.nyxos.thunar.copy-path-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-copy-path.sh %f</command>
    <description>Copy the exact selected path to the clipboard (does not resolve symlinks)</description>
    <patterns>*</patterns>
    <directories/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>dialog-password</icon>
    <name>NyxOS GPG Encrypt</name>
    <unique-id>org.nyxos.thunar.gpg-encrypt-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-gpg-encrypt.sh %F</command>
    <description>Symmetrically encrypt the selected file(s) with gpg (AES256) — passphrase never touches disk</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>dialog-password</icon>
    <name>NyxOS GPG Decrypt</name>
    <unique-id>org.nyxos.thunar.gpg-decrypt-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-gpg-decrypt.sh %F</command>
    <description>Decrypt the selected .gpg/.asc file(s) — passphrase never touches disk</description>
    <patterns>*.gpg;*.asc</patterns>
    <startup-notify/>
    <other-files/>
    <text-files/>
  </action>

  <action>
    <icon>document-sign</icon>
    <name>NyxOS GPG Sign</name>
    <unique-id>org.nyxos.thunar.gpg-sign-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-gpg-sign.sh %F</command>
    <description>Create a detached GPG signature (.sig) for the selected file(s)</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>document-sign</icon>
    <name>NyxOS GPG Verify</name>
    <unique-id>org.nyxos.thunar.gpg-verify-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-gpg-verify.sh %f</command>
    <description>Verify a detached GPG signature (.sig/.asc) against its signed file</description>
    <patterns>*.sig;*.asc</patterns>
    <other-files/>
    <text-files/>
  </action>

  <action>
    <icon>dialog-password</icon>
    <name>NyxOS OpenSSL Encrypt</name>
    <unique-id>org.nyxos.thunar.openssl-encrypt-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-openssl.sh encrypt %F</command>
    <description>Encrypt the selected file(s) with openssl (AES-256-CBC, PBKDF2) — passphrase never touches disk</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>dialog-password</icon>
    <name>NyxOS OpenSSL Decrypt</name>
    <unique-id>org.nyxos.thunar.openssl-decrypt-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-openssl.sh decrypt %F</command>
    <description>Decrypt the selected openssl-encrypted file(s) — passphrase never touches disk</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>text-x-generic</icon>
    <name>NyxOS Hex View</name>
    <unique-id>org.nyxos.thunar.hexview-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-hexview.sh %f</command>
    <description>View the selected file as a hex dump (xxd) in a paged terminal</description>
    <patterns>*</patterns>
    <startup-notify/>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>utilities-system-monitor</icon>
    <name>NyxOS Entropy Analysis</name>
    <unique-id>org.nyxos.thunar.entropy-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-entropy.sh %f</command>
    <description>Run Shannon entropy analysis (ent) — high entropy suggests genuinely compressed/encrypted data</description>
    <patterns>*</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>text-x-generic</icon>
    <name>NyxOS Compare Files</name>
    <unique-id>org.nyxos.thunar.compare-1</unique-id>
    <command>/usr/lib/nyx/thunar/nyx-thunar-compare.sh %F</command>
    <description>Show a unified diff between exactly two selected files</description>
    <patterns>*</patterns>
    <audio-files/>
    <image-files/>
    <other-files/>
    <text-files/>
    <video-files/>
  </action>

  <action>
    <icon>web-browser</icon>
    <name>Open with Nyx Browser</name>
    <unique-id>org.nyxos.thunar.open-nyx-browser-1</unique-id>
    <command>/usr/bin/nyx-browser %f</command>
    <description>Open the selected HTML file in Nyx Browser</description>
    <patterns>*.html;*.htm</patterns>
    <text-files/>
  </action>

  <action>
    <icon>web-browser</icon>
    <name>Open with Nyx Oniux Browser</name>
    <unique-id>org.nyxos.thunar.open-nyx-oniux-browser-1</unique-id>
    <command>/usr/bin/nyx-oniux-browser %f</command>
    <description>Open the selected HTML file in Nyx Oniux Browser (per-app Tor isolation)</description>
    <patterns>*.html;*.htm</patterns>
    <text-files/>
  </action>

  <action>
    <icon>web-browser</icon>
    <name>Open with Nyx Tor Browser</name>
    <unique-id>org.nyxos.thunar.open-nyx-tor-browser-1</unique-id>
    <command>/usr/bin/nyx-tor-browser %f</command>
    <description>Open the selected HTML file in Tor Browser</description>
    <patterns>*.html;*.htm</patterns>
    <text-files/>
  </action>
</actions>
