# Maintainer: NyxOS
# Packages Thunar custom-action glue only — no compilation. Delegates the
# actual privileged/destructive logic to nyx-wipe and nyx-isolation, both
# separate packages this one depends on.
pkgname=nyx-thunar-integration
pkgver=0.1.0
pkgrel=1
pkgdesc="NyxOS Thunar context-menu integration (secure wipe, sandbox shell, metadata strip, checksum, root open, copy path, GPG/OpenSSL encrypt-decrypt-sign-verify, hex view, entropy analysis, file compare)"
arch=('any')
license=('MIT')
depends=('thunar' 'zenity' 'mat2' 'polkit' 'gnupg' 'openssl' 'nyx-wipe' 'nyx-isolation')
optdepends=('xclip: clipboard support for Copy Path' 'libnotify: desktop notifications on completion'
            'vim: provides xxd for Hex View' 'ent: entropy analysis' 'xfce4-terminal: paged Hex View output')

_repo_root="$startdir/../../.."
_thunar_dir="$_repo_root/install/thunar"

package() {
  # Not /etc/xdg/Thunar/uca.xml: the thunar package owns that file and pacman
  # refuses to let two packages own one path. Thunar loads a single uca.xml
  # (~/.config first, else /etc/xdg) with no merging, so seeding each new
  # user's ~/.config via /etc/skel is the supported override point; mkarchiso
  # copies skel into the live user's home and archinstall's useradd -m does
  # the same for installed users.
  install -Dm644 "$_thunar_dir/uca.xml" \
    "$pkgdir/etc/skel/.config/Thunar/uca.xml"

  install -Dm644 "$_thunar_dir/nyx-thunar-common.sh" \
    "$pkgdir/usr/lib/nyx/thunar/nyx-thunar-common.sh"

  for script in wipe sandbox metadata checksum root copy-path \
      gpg-encrypt gpg-decrypt gpg-sign gpg-verify openssl hexview entropy compare; do
    install -Dm755 "$_thunar_dir/nyx-thunar-$script.sh" \
      "$pkgdir/usr/lib/nyx/thunar/nyx-thunar-$script.sh"
  done
}
