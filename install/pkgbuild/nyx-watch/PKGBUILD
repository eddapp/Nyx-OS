# Maintainer: NyxOS
# Builds straight from this monorepo's Cargo workspace — no source= tarball,
# $startdir is install/pkgbuild/nyx-watch so three levels up is the repo root.
pkgname=nyx-watch
pkgver=0.1.0
pkgrel=1
pkgdesc="NyxOS process/socket/route/firewall change-detection daemon"
arch=('x86_64')
license=('MIT')
depends=('iproute2' 'nftables' 'systemd')
makedepends=('cargo')

_repo_root="$startdir/../../.."

build() {
  cd "$_repo_root"
  cargo build --release --locked -p nyx-watch --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/nyx-watch" \
    "$pkgdir/usr/bin/nyx-watch"
  install -Dm644 "$_repo_root/core/crates/nyx-watch/packaging/nyx-watch.service" \
    "$pkgdir/usr/lib/systemd/system/nyx-watch.service"
}
