# Maintainer: NyxOS
# Builds straight from this monorepo's Cargo workspace — no source= tarball,
# $startdir is install/pkgbuild/nyx-integrity so three levels up is the repo root.
pkgname=nyx-integrity
pkgver=0.1.0
pkgrel=1
pkgdesc="NyxOS system and package integrity verification daemon"
arch=('x86_64')
license=('MIT')
depends=('pacman' 'systemd')
makedepends=('cargo')

_repo_root="$startdir/../../.."

build() {
  cd "$_repo_root"
  cargo build --release --locked -p nyx-integrity --target-dir "$srcdir/target"
}

package() {
  install -Dm755 "$srcdir/target/release/nyx-integrity" \
    "$pkgdir/usr/bin/nyx-integrity"
  install -Dm644 "$_repo_root/core/crates/nyx-integrity/packaging/nyx-integrity.service" \
    "$pkgdir/usr/lib/systemd/system/nyx-integrity.service"
}
