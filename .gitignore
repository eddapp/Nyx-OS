# Rust
# Cargo.lock is intentionally NOT ignored: nyx-health/nyx-dashboard are
# binaries and their PKGBUILDs build with --locked, so it must be committed.
/target/
**/target/

# archiso build output
/iso/work/
/iso/out/
/iso/aur-work/
/iso/local-repo/
/iso/pacman.conf.local

# NyxOS build-signing GPG keyring -- private key material, generated
# per-build-host by iso/sign-packages.sh, never the developer's own
# personal ~/.gnupg and never to be committed.
/iso/nyx-signing-gpg/

# signed warrant canary staged into the ISO by iso/sign-packages.sh
# (sign_canary) at build time -- CANARY.md at the repo root is the source
/iso/airootfs/usr/share/nyxos/CANARY.md
/iso/airootfs/usr/share/nyxos/CANARY.md.asc
/iso/airootfs/usr/share/nyxos/nyxos-build-signing-key.asc

# staged at build time by iso/build.sh: the signed [nyxos] repo, its pacman
# keyring, the installer's package-list copy, and the server profile's
# console-autologin drop-in
/iso/airootfs/opt/nyxos/repo/
/iso/airootfs/usr/share/pacman/keyrings/
/iso/airootfs/usr/share/nyxos/installer/packages.x86_64
/iso/airootfs/etc/systemd/system/getty@tty1.service.d/

# built OS images (too large for git; build artifacts, not source)
/archlinux/
*.iso
*.img
*.qcow2

# makepkg artifacts, including upstream source tarballs makepkg downloads
# next to a PKGBUILD (mieru/mita fetch theirs by URL with pinned sha256sums)
install/pkgbuild/*/pkg/
install/pkgbuild/*/src/
install/pkgbuild/*/*.pkg.tar.*
install/pkgbuild/*/*.log
install/pkgbuild/*/*.tar.gz
install/pkgbuild/*/*.tar.xz
install/pkgbuild/*/*.zip

# JetBrains
.idea/
