# NyxOS AppArmor profile for Zen Browser — confines the browser's parent and
# content processes to what a Firefox-family browser actually needs.
#
# This is an independent design written against AppArmor's own documented
# rule syntax (apparmor.d(5), the abi/4.0 feature set shipped by the
# `apparmor` 4.1.7 package NyxOS installs) and Firefox/Zen's publicly
# documented multi-process/namespace sandbox model. It is not copied from
# any other distro's or project's shipped profile.
#
# Real install-path reasoning: the `zen-browser-bin` AUR package (real
# binary release, not built from source — Firefox-scale source builds don't
# belong in an ISO pipeline) installs a thin wrapper at /usr/bin/zen-browser
# that does a plain `exec /opt/zen-browser-bin/zen-bin "$@"` — a direct exec,
# no fork. So this profile attaches at the wrapper path (the actual first
# exec target from the .desktop launcher) and grants the real binary `ix`
# (execute, inherit this same profile) rather than trying to force one
# attachment glob across two unrelated directory trees. Profile data lives
# under ~/.config/zen/ and ~/.cache/zen/ for this tarball-style install
# (confirmed against Zen's own install docs) — NOT ~/.zen/, which is a
# different, non-tarball packaging convention this build doesn't use.
#
# Scope note: this profile does NOT contain a `network` rule block. AppArmor
# only starts mediating a given resource class once a profile contains at
# least one rule for it, so omitting `network` entirely means AppArmor
# imposes no network restriction here — and that is deliberate, not an
# oversight. NyxOS's actual network confinement (VPN/Tor kill switch, DNS
# enforcement, firewall policy) is already handled at the nftables/socket
# layer by nyx-health, nyx-vpn and nyx-dns; duplicating a coarse allow-all
# `network,` rule here would add nothing, and a restrictive one would fight
# those daemons' own runtime policy changes. AppArmor's job in this file is
# file/IPC/namespace confinement, not packet filtering.

abi <abi/4.0>,

#include <tunables/global>

profile zen-browser /usr/bin/zen-browser flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/fonts>
  #include <abstractions/nameservice>

  # --- Namespaces -----------------------------------------------------
  #
  # Firefox-family browsers build their own internal content-process
  # sandbox on top of unprivileged user namespaces (unshare(CLONE_NEWUSER)
  # plus mount/pid namespaces for the content process jail). On AppArmor
  # 4.x, creating a user namespace from inside a confined profile is
  # mediated by its own `userns` rule; without it here, Zen doesn't get
  # denied outright — it silently falls back to running its content
  # processes without its own internal sandbox layer, which is worse than
  # either failing loudly or being properly confined. Grant it explicitly.
  userns,

  # Same multi-process architecture needs to signal and, for its own
  # built-in crash/sandbox monitor, ptrace its own content processes; both
  # are scoped to peers running under this same profile, never a bare
  # "ptrace anything" grant.
  signal (send, receive) peer=zen-browser,
  ptrace (read, trace) peer=zen-browser,

  # Anonymous AF_UNIX socketpairs are how the parent process talks to its
  # own content/GPU/socket processes. Scoped to same-profile peers only.
  unix (send, receive, connect, accept) type=stream peer=(label=zen-browser),

  # --- The browser binary itself ---------------------------------------
  # Wrapper script (this profile's own attachment point, read so bash can
  # interpret it) execs directly into the real binary, staying under this
  # same profile (`ix`) rather than transitioning to a differently-named
  # one or going unconfined.
  /usr/bin/zen-browser r,
  /opt/zen-browser-bin/zen-bin ix,
  /opt/zen-browser-bin/** mr,

  # --- Profile / cache / config: full read-write, this is the browser's
  # own data --------------------------------------------------------------
  owner @{HOME}/.config/zen/ rw,
  owner @{HOME}/.config/zen/** rwk,
  owner @{HOME}/.cache/zen/ rw,
  owner @{HOME}/.cache/zen/** rwk,

  # --- Deliberately scoped general file access -------------------------
  #
  # Only Downloads and Desktop get real file access, not a blanket
  # "@{HOME}/** rw" or the stock abstractions/user-download abstraction.
  # A compromised content process is still confined by this profile even
  # after any internal sandbox bypass, and the whole point of that second
  # layer is defeated if it can read or write anything anywhere in the
  # user's home directory — a broad home-wide grant would hand an exploited
  # renderer every private document, SSH key, or password vault in
  # @{HOME} for free. Downloads/Desktop are where a browser legitimately
  # needs to save files a user asked it to save, and nowhere else.
  owner @{HOME}/Downloads/ rw,
  owner @{HOME}/Downloads/** rwk,
  owner @{HOME}/Desktop/ rw,
  owner @{HOME}/Desktop/** rwk,

  # Scratch space Firefox-family browsers genuinely use for temp downloads,
  # PDF.js/print rendering, and screenshot staging — owner-scoped so this
  # can't touch another user's temp files.
  owner /tmp/** rwk,
  owner /tmp/ rw,

  # --- Read-only system paths -------------------------------------------
  /usr/share/fonts/** r,
  /etc/fonts/** r,
  /usr/share/fontconfig/** r,
  owner @{HOME}/.fonts/** r,
  owner @{HOME}/.local/share/fonts/** r,

  /usr/share/hunspell/** r,
  /usr/share/myspell/** r,

  /usr/share/mime/** r,
  /etc/mime.types r,

  # --- D-Bus session bus / xdg-desktop-portal ---------------------------
  #
  # Scoped to the portal and notification interfaces Zen actually calls
  # (file picker, screen-share picker, notifications), not a blanket
  # session-bus abstraction.
  dbus send bus=session peer=(name=org.freedesktop.DBus),
  dbus receive bus=session peer=(name=org.freedesktop.DBus),
  dbus (send, receive) bus=session peer=(name=org.freedesktop.portal.Desktop, label=unconfined),
  dbus (send, receive) bus=session peer=(name=org.freedesktop.Notifications, label=unconfined),
  dbus (send, receive) bus=session peer=(name=org.a11y.Bus, label=unconfined),

  # --- PipeWire (screen-share / webcam / audio) and PulseAudio-compat ---
  owner /run/user/[0-9]*/pipewire-0 rw,
  owner /run/user/[0-9]*/pulse/native rw,

  # --- GPU: /dev/dri + the sysfs paths hardware-accelerated rendering
  # (WebGL, VA-API video decode) actually reads and pokes ------------------
  /dev/dri/card[0-9]* rw,
  /dev/dri/renderD[0-9]* rw,
  /sys/class/drm/ r,
  /sys/class/drm/** r,
  /sys/devices/pci[0-9]*/**/drm/** rw,

  # --- /proc: scoped to the browser's own processes, not /proc/** --------
  @{PROC}/@{pid}/net/route r,
  @{PROC}/@{pid}/net/if_inet6 r,
  @{PROC}/@{pid}/net/ipv6_route r,
  @{PROC}/@{pid}/stat r,
  @{PROC}/@{pid}/statm r,
  @{PROC}/@{pid}/status r,
  @{PROC}/@{pid}/oom_score_adj rw,
  @{PROC}/@{pid}/task/ r,
  @{PROC}/@{pid}/task/** r,
  @{PROC}/sys/kernel/yama/ptrace_scope r,
  @{PROC}/sys/vm/overcommit_memory r,
  @{PROC}/cpuinfo r,
  @{PROC}/meminfo r,

  # --- Explicit denials --------------------------------------------------
  #
  # Named out loud even though most of these would already fail to match
  # any allow rule above (default-deny) — an explicit `deny` also silences
  # the matching allow-rule audit noise and, more importantly, survives
  # this profile picking up a broader abstraction later without silently
  # re-opening access to it.
  deny /root/** rwklx,
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /etc/ssh/** rwklx,
  deny /etc/sudoers r,
  deny /etc/sudoers.d/** rwklx,
  deny /var/log/** rwklx,

  # NyxOS control-plane paths: a browser process — confined or not — has
  # no legitimate reason to ever touch a Nyx daemon's config or socket.
  deny /etc/nyx/** rwklx,
  deny /run/nyx/** rwklx,
  deny /run/nyx-telemetry/** rwklx,

  # --- MIME-handler helper: its own narrowly-scoped child profile --------
  #
  # `Cx` (clean exec, child-profile transition) rather than `ix` (stay in
  # this profile) or `ux` (fully unconfined): a MIME-handler exploit
  # triggered by opening a downloaded file should not inherit this
  # profile's Downloads/Desktop *write* access or its Zen profile/cache
  # access. The child profile below gets read-only access to what it needs
  # to resolve and hand off to a handler, nothing more.
  /usr/bin/xdg-open Cx -> xdg-open,
  /usr/bin/xdg-mime Cx -> xdg-open,

  profile xdg-open flags=(attach_disconnected) {
    #include <abstractions/base>

    /usr/bin/xdg-open r,
    /usr/bin/xdg-mime r,
    /usr/bin/xdg-settings r,

    # Resolving a MIME type to a handler means reading desktop files and
    # the user's own handler-association list.
    /usr/share/applications/ r,
    /usr/share/applications/** r,
    owner @{HOME}/.local/share/applications/ r,
    owner @{HOME}/.local/share/applications/** r,
    owner @{HOME}/.config/mimeapps.list r,

    # Read-only on Downloads/Desktop: this helper needs to read the file
    # it's handing off to a handler, but never gets the write access the
    # parent zen-browser profile has there.
    owner @{HOME}/Downloads/** r,
    owner @{HOME}/Desktop/** r,
    owner /tmp/** r,

    dbus send bus=session peer=(name=org.freedesktop.DBus),
    dbus receive bus=session peer=(name=org.freedesktop.DBus),
    dbus (send, receive) bus=session peer=(name=org.freedesktop.portal.OpenURI, label=unconfined),

    # The resolved handler runs confined under this same restricted
    # profile (inherit) rather than a fresh unconfined exec — a real
    # per-application handler profile (transitioned via `px` to that
    # app's own top-level profile) is the natural next step once NyxOS
    # ships AppArmor profiles for individual desktop apps, but "confined
    # under this narrow profile" is still strictly safer than "unconfined"
    # as a default.
    /usr/bin/* ix,
    /usr/local/bin/* ix,

    deny /root/** rwklx,
    deny @{HOME}/.config/zen/** rwklx,
    deny @{HOME}/.cache/zen/** rwklx,
    deny @{HOME}/Downloads/** w,
    deny @{HOME}/Desktop/** w,
    deny /etc/nyx/** rwklx,
    deny /run/nyx/** rwklx,
    deny /run/nyx-telemetry/** rwklx,
  }
}
