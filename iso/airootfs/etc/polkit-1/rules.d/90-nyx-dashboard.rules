// NyxOS desktop session: matches Kodachi's live-session trust model (no
// per-action password prompt once logged into the desktop session,
// confirmed via Kodachi's own docs — its live "kodachi" user already
// carries sudo rights its dashboard's scripts depend on) for the real
// binaries NyxOS's own GUI tools invoke via pkexec: nyx-hardening
// (dashboard's schedule status/install/remove), xdg-open (dashboard's
// "open VPN profile config directory as root"), and thunar
// (nyx-thunar-root.sh's "Open As Root" action). pkexec still authorizes
// and logs every one of these calls via its own audit trail regardless of
// this rule — what changes is that polkit no longer additionally blocks
// on an interactive password prompt for them specifically. This rule is
// scoped to these three program paths only, never a blanket exec grant,
// and numbered 90 (evaluated after any lower-numbered vendor/default
// rules) so it's the definitive answer for these three actions.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec") {
        return polkit.Result.NOT_HANDLED;
    }
    var program = action.lookup("program");
    var allowed = [
        "/usr/bin/nyx-hardening",
        "/usr/bin/xdg-open",
        "/usr/bin/thunar",
    ];
    if (allowed.indexOf(program) == -1) {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
