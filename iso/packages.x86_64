# NyxOS package set: vanilla Arch base + BlackArch privacy/anonymity tool
# groups + XFCE desktop. One package name per line, '#' starts a comment.

# --- Base system ---
base
base-devel
linux
linux-firmware
linux-headers
mkinitcpio
mkinitcpio-archiso
sudo
which
vim
nano
git
man-db
man-pages
bash-completion
reflector

# --- Boot / install tooling ---
syslinux
grub
efibootmgr
intel-ucode
amd-ucode
dosfstools
e2fsprogs
gptfdisk
parted
cryptsetup
arch-install-scripts
archinstall
rsync

# --- Networking core ---
networkmanager
network-manager-applet
nftables
openssh
wireguard-tools
openvpn
xray
shadowsocks-rust
badvpn
iproute2
iputils
traceroute
curl

# --- Privacy stack (control layer targets) ---
tor
dnscrypt-proxy

# --- Secure communications: onion-routed messenger + anonymous file
# sharing. Both real, independent projects (not NyxOS-authored) —
# onionshare ships directly from Arch's own 'extra' repo; session-desktop
# has no official/BlackArch package, built from AUR via
# iso/build-aur-packages.sh into the local [nyxos] repo, same mechanism as
# zen-browser-bin/oniux. ---
onionshare
session-desktop

# --- Second anonymity network, alongside Tor. Ships its own systemd unit
# (i2pd.service) with sane upstream defaults; deliberately not enabled by
# default or wired into nyx-health — most users run one anonymity network
# at a time, and Tor already owns that role here. Available to opt into. ---
i2pd

# --- Encrypted-container volumes (VeraCrypt-style), distinct from
# gocryptfs's filesystem-level encryption. Official 'extra' package, ships
# its own GUI and CLI (`veracrypt`/`veracrypt-nogui`) — not wrapped in a
# Nyx-native CLI, that would just be the "overlapping duplicate tool"
# problem this project deliberately avoids elsewhere. ---
veracrypt

# --- NyxOS control layer (built from install/pkgbuild/, see build.sh) ---
nyx-health
nyx-vpn
nyx-identity
nyx-devices
nyx-telemetry
nyx-diagnostics
nyx-dns
nyx-integrity
nyx-wipe
nyx-isolation
nyx-workflow
nyx-hardening
nyx-watch
nyx-thunar-integration
nyx-desktop-sessions
nyx-dashboard
nyx-browsers

# --- Graphics / display ---
xorg-server
xorg-xinit
mesa
xf86-video-vesa

# --- Desktop environment ---
xfce4
xfce4-goodies
# Explicit even though the xfce4 group pulls it in transitively: xfwm4 is
# the window manager for the default "Xfce Session" login (Nyx Classic).
# Listed directly so removing/trimming some other xfce4 component can never
# take it along and silently break the default session.
xfwm4
lightdm
lightdm-gtk-greeter
pipewire
pipewire-pulse
pavucontrol
ttf-dejavu
noto-fonts

# --- Default browser ---
# Zen (Firefox-based) — no official/BlackArch package, built from the
# zen-browser-bin AUR PKGBUILD at ISO-build time via
# iso/build-aur-packages.sh into the same local [nyxos] repo NyxOS's own
# packages use, so it resolves here exactly like any other package name.
zen-browser-bin

# Tor Browser — ships directly from the already-enabled [blackarch] repo,
# no separate download-on-first-run launcher needed.
tor-browser

# oniux — real per-application Tor isolation tool (Tor Project,
# MIT/Apache-2.0), no official/BlackArch package, built from AUR via
# iso/build-aur-packages.sh into the same local [nyxos] repo, exactly like
# zen-browser-bin.
oniux

# --- Mandatory access control (AppArmor) — Zen's profile at
# iso/airootfs/etc/apparmor.d/usr.bin.zen-browser, enabled via the
# multi-user.target.wants/apparmor.service symlink and the lsm= kernel
# param in the boot configs. ---
apparmor

# --- Nyx Tiling desktop profile (optional login session selectable at the
# LightDM greeter; xfwm4 above remains the default WM for Nyx Classic) —
# see install/desktop-sessions/ and the nyx-desktop-sessions package. ---
i3-wm
i3status
i3lock
dmenu
polkit-gnome

# --- Rust toolchain for the control layer ---
rust

# --- BlackArch: anonymity / anti-forensics / crypto tooling ---
blackarch-anti-forensic
blackarch-crypto
blackarch-proxy
blackarch-spoof
blackarch-sniffer
blackarch-networking
blackarch-forensic

# --- Wireless/Bluetooth/malware-analysis essentials (audited against
# Kali's own tool metapackages 2026-09-18 — Kodachi has no equivalent for
# these at all). Named individual tools, not whole blackarch-<category>
# groups (a normal Kali or Kodachi install doesn't ship a category's full
# tool set by default either) — these six are all in Arch's own official
# `extra` repo, no BlackArch dependency needed for this part at all.
aircrack-ng
kismet
wifite
reaver
bettercap
yara

# --- SDR + blue-team/defensive tooling: individual BlackArch packages,
# same "named tools, not whole groups" reasoning as above. Kodachi has no
# defensive-security angle at all, so this is a real differentiator rather
# than catch-up. ---
gqrx-scanner
rtl-433
chkrootkit
suricata
zeek

# --- Application isolation (backs nyx-isolation) ---
firejail
firetools
podman

# --- Desktop security/privacy apps, wired into Thunar/nyx-wipe/nyx-isolation ---
keepassxc
mat2
perl-image-exiftool
wipe
gocryptfs
usbguard
xterm
ent
gnupg
openssl
xclip
ethtool
usbutils
secure-delete
